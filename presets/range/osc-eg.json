{
  "preset": {
    "name": "OSC e.g.",
    "description": "This preset sends range to OSC"
  },
  "engine": {
    "engine-midi": {
      "dist": {
        "cc_nb": 2,
        "channel": 1,
        "enabled": true,
        "hires": false,
        "cc_max": 127,
        "cc_min": 0,
        "nbOfNotes": 15,
        "sustain": 0.8,
        "rootNote": 55,
        "pattern": "scale",
        "scaleType": "major pentatonic",
        "tl_mode": 0,
        "velocity": 100
      }
    },
    "engine-osc": {
      "dist": {
        "enabled": true,
        "mode_raw": true,
        "osc_max": 1,
        "osc_min": 0,
        "osc_addr": "dist"
      }
    }
  },
  "inputs": {
    "dist": {
      "deadzone": 0.4,
      "offset": 0.0,
      "inverted": false,
      "lmax": 60.0,
      "lmin": 2.0,
      "mode": false,
      "th_mode": false,
      "cyclic": false,
      "over_out": false
    }
  },
  "general": {
    "Wifi_mode": "STA",
    "OSC_ENA": true,
    "OSC_IP": "192.168.10.2",
    "OSC_PORT": 8000,
    "MidiEnabled": false,
    "HidEnabled": false,
    "HidMode": 2,
    "PipoName": "range",
    "BLEEnabled": false
  },
  "sensorconf": {
    "hold_mode": true
  }
}
